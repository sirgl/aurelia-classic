        (id: "core:tech/mobile-tactics", era_name: Some("Information"), unlocks_buildings: [], cost: 7700, requires: ["core:tech/ecology", "core:tech/nuclear-fission"], effects: [(scope: City, selector: OwnerCities, modifier: AddYieldPercent(yield_kind: Output, percent: 10))]),
