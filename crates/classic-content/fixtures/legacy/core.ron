        (id: "core:tech/iron-working", era_name: Some("Classical"), unlocks_buildings: [], cost: 195, requires: ["core:tech/bronze-working"], effects: [(scope: City, selector: OwnerCities, modifier: AddYieldPercent(yield_kind: Output, percent: 10))]),
