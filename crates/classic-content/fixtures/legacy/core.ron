        (id: "core:tech/optics", era_name: Some("Classical"), unlocks_buildings: ["core:building/lighthouse"], cost: 85, requires: ["core:tech/sailing"], effects: [(scope: City, selector: OwnerCities, modifier: AddYieldPercent(yield_kind: Output, percent: 10))]),
