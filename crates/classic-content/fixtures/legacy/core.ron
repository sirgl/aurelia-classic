// Base game content (core set): the main source of truth
// (plus civs.ron, the set of civilizations, see classic-content/src/civs.rs).
// Rust code does NOT duplicate it: core_rules() parses this file via include_str!
// (deterministic, works without the FS: web and tests). Mods go as separate
// files via the loader + manifest (§17).

(
    // Units (sorted by key at compile time). required_tech is resolved in
    // a second pass: without the tech EnqueueProduction is rejected ("unit locked"),
    // the HUD shows a lock. Placeholders (settler/warrior/worker) are available from the first
    // turn. movement: base movement points; strength: in combat.
    units: [
        (id: "core:unit/archer", movement: 3, strength: 8, founder: false, builder: false, cost: 35, effects: [], required_tech: Some("core:tech/archery")),
        (id: "core:unit/horseman", movement: 4, strength: 12, founder: false, builder: false, cost: 50, effects: [], required_tech: Some("core:tech/horseback-riding")),
        (id: "core:unit/settler", movement: 2, strength: 1, founder: true, builder: false, cost: 40, effects: [], required_tech: None),
        (id: "core:unit/swordsman", movement: 2, strength: 15, founder: false, builder: false, cost: 50, effects: [], required_tech: Some("core:tech/iron-working")),
        (id: "core:unit/warrior", movement: 2, strength: 10, founder: false, builder: false, cost: 30, effects: [], required_tech: None),
        (id: "core:unit/worker", movement: 2, strength: 1, founder: false, builder: true, cost: 30, effects: [], required_tech: None),
    ],
    // City buildings (sorted by key at compile time): unlocking is by
    // required_tech, which must also stand in this tech's unlocks_buildings
    // (a test checks the symmetry). Effects are typed records
    // (see classic-content/src/effects.rs): AddYield(Output) is a flat +N to the
    // city's total output (half goes to the production queue), AddYieldPercent
    // (Output) is +P% to the same (the additive stage).
    // Wonders (wonder: true) are globally unique: the validator rejects the
    // order of any player once the wonder is built; in a race of completions
    // the first city gets it.
    buildings: [
        (id: "core:building/bank", cost: 340, effects: [(scope: City, selector: SourceCity, modifier: AddYieldPercent(yield_kind: Output, percent: 15))], required_tech: Some("core:tech/banking")),
        (id: "core:building/barracks", cost: 80, effects: [(scope: City, selector: SourceCity, modifier: AddYield(yield_kind: Output, amount: 3))], required_tech: Some("core:tech/bronze-working")),
        (id: "core:building/factory", cost: 450, effects: [(scope: City, selector: SourceCity, modifier: AddYieldPercent(yield_kind: Output, percent: 20))], required_tech: Some("core:tech/industrialization")),
        (id: "core:building/granary", cost: 60, effects: [(scope: City, selector: SourceCity, modifier: AddYield(yield_kind: Output, amount: 2))], required_tech: Some("core:tech/pottery")),
        (id: "core:building/great_library", cost: 350, effects: [(scope: City, selector: SourceCity, modifier: AddYield(yield_kind: Output, amount: 5))], required_tech: Some("core:tech/writing"), wonder: true),
        (id: "core:building/library", cost: 110, effects: [(scope: City, selector: SourceCity, modifier: AddYield(yield_kind: Output, amount: 3))], required_tech: Some("core:tech/writing")),
        (id: "core:building/lighthouse", cost: 130, effects: [(scope: City, selector: SourceCity, modifier: AddYield(yield_kind: Output, amount: 3))], required_tech: Some("core:tech/optics")),
        (id: "core:building/market", cost: 150, effects: [(scope: City, selector: SourceCity, modifier: AddYield(yield_kind: Output, amount: 4))], required_tech: Some("core:tech/currency")),
        (id: "core:building/monument", cost: 50, effects: [(scope: City, selector: SourceCity, modifier: AddYield(yield_kind: Output, amount: 2))], required_tech: None),
        (id: "core:building/oracle", cost: 300, effects: [(scope: City, selector: SourceCity, modifier: AddYieldPercent(yield_kind: Output, percent: 15))], required_tech: Some("core:tech/philosophy"), wonder: true),
        (id: "core:building/pyramids", cost: 250, effects: [(scope: City, selector: SourceCity, modifier: AddYield(yield_kind: Output, amount: 4))], required_tech: Some("core:tech/masonry"), wonder: true),
        (id: "core:building/shrine", cost: 70, effects: [(scope: City, selector: SourceCity, modifier: AddYield(yield_kind: Output, amount: 2))], required_tech: Some("core:tech/calendar")),
        (id: "core:building/temple", cost: 180, effects: [(scope: City, selector: SourceCity, modifier: AddYield(yield_kind: Output, amount: 4))], required_tech: Some("core:tech/theology")),
        (id: "core:building/university", cost: 280, effects: [(scope: City, selector: SourceCity, modifier: AddYield(yield_kind: Output, amount: 5))], required_tech: Some("core:tech/education")),
        (id: "core:building/workshop", cost: 200, effects: [(scope: City, selector: SourceCity, modifier: AddYieldPercent(yield_kind: Output, percent: 15))], required_tech: Some("core:tech/machinery")),
    ],
    // Technologies. The v1 rule "+10% to the total output of cities for every
    // learned technology" is an effect of the technology itself (it used to be code in
    // yields.rs); remove or replace it with other rules by editing data.
    technologies: [
        // ── Ancient Era ──
        (id: "core:tech/agriculture", era_name: Some("Ancient"), unlocks_buildings: [], cost: 20, requires: [], effects: [(scope: City, selector: OwnerCities, modifier: AddYieldPercent(yield_kind: Output, percent: 10))]),
        (id: "core:tech/animal-husbandry", era_name: Some("Ancient"), unlocks_buildings: [], cost: 35, requires: ["core:tech/agriculture"], effects: [(scope: City, selector: OwnerCities, modifier: AddYieldPercent(yield_kind: Output, percent: 10))]),
        (id: "core:tech/archery", era_name: Some("Ancient"), unlocks_buildings: [], cost: 35, requires: ["core:tech/agriculture"], effects: [(scope: City, selector: OwnerCities, modifier: AddYieldPercent(yield_kind: Output, percent: 10))]),
        (id: "core:tech/bronze-working", era_name: Some("Ancient"), unlocks_buildings: ["core:building/barracks"], cost: 55, requires: ["core:tech/mining"], effects: [(scope: City, selector: OwnerCities, modifier: AddYieldPercent(yield_kind: Output, percent: 10))]),
        (id: "core:tech/calendar", era_name: Some("Ancient"), unlocks_buildings: ["core:building/shrine"], cost: 55, requires: ["core:tech/pottery"], effects: [(scope: City, selector: OwnerCities, modifier: AddYieldPercent(yield_kind: Output, percent: 10))]),
        (id: "core:tech/masonry", era_name: Some("Ancient"), unlocks_buildings: ["core:building/pyramids"], cost: 55, requires: ["core:tech/mining"], effects: [(scope: City, selector: OwnerCities, modifier: AddYieldPercent(yield_kind: Output, percent: 10))]),
        (id: "core:tech/mining", era_name: Some("Ancient"), unlocks_buildings: [], cost: 35, requires: ["core:tech/agriculture"], effects: [(scope: City, selector: OwnerCities, modifier: AddYieldPercent(yield_kind: Output, percent: 10))]),
        (id: "core:tech/pottery", era_name: Some("Ancient"), unlocks_buildings: ["core:building/granary"], cost: 35, requires: ["core:tech/agriculture"], effects: [(scope: City, selector: OwnerCities, modifier: AddYieldPercent(yield_kind: Output, percent: 10))]),
        (id: "core:tech/sailing", era_name: Some("Ancient"), unlocks_buildings: [], cost: 55, requires: ["core:tech/pottery"], effects: [(scope: City, selector: OwnerCities, modifier: AddYieldPercent(yield_kind: Output, percent: 10))]),
        (id: "core:tech/the-wheel", era_name: Some("Ancient"), unlocks_buildings: [], cost: 55, requires: ["core:tech/animal-husbandry", "core:tech/archery"], effects: [(scope: City, selector: OwnerCities, modifier: AddYieldPercent(yield_kind: Output, percent: 10))]),
        (id: "core:tech/trapping", era_name: Some("Ancient"), unlocks_buildings: [], cost: 55, requires: ["core:tech/animal-husbandry"], effects: [(scope: City, selector: OwnerCities, modifier: AddYieldPercent(yield_kind: Output, percent: 10))]),
        (id: "core:tech/writing", era_name: Some("Ancient"), unlocks_buildings: ["core:building/great_library", "core:building/library"], cost: 55, requires: ["core:tech/pottery"], effects: [(scope: City, selector: OwnerCities, modifier: AddYieldPercent(yield_kind: Output, percent: 10))]),

        // ── Classical Era ──
        (id: "core:tech/construction", era_name: Some("Classical"), unlocks_buildings: [], cost: 105, requires: ["core:tech/masonry", "core:tech/the-wheel"], effects: [(scope: City, selector: OwnerCities, modifier: AddYieldPercent(yield_kind: Output, percent: 10))]),
        (id: "core:tech/currency", era_name: Some("Classical"), unlocks_buildings: ["core:building/market"], cost: 175, requires: ["core:tech/mathematics"], effects: [(scope: City, selector: OwnerCities, modifier: AddYieldPercent(yield_kind: Output, percent: 10))]),
