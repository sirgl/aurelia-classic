# Translation of classic-ui-unit-actions.ftl into zh-Hans. Keys are in the order of the English file.
# Lines marked TODO still hold the English text: translate them and delete the marker.

classic.ui.unit-actions.move.label = 移动
classic.ui.unit-actions.move.desc = 为该单位选择目的地并查看路线。
classic.ui.unit-actions.attack.label = 攻击
classic.ui.unit-actions.attack.desc = 查看目标并比较预期的战斗结果。
classic.ui.unit-actions.fortify.label = 设防
classic.ui.unit-actions.fortify.desc = 进入防御姿态，坚守此地块。
classic.ui.unit-actions.skip.label = 跳过
classic.ui.unit-actions.skip.desc = 本回合让该单位原地待命。
classic.ui.unit-actions.heal.label = 治疗
classic.ui.unit-actions.heal.desc = 原地休整，直到单位恢复。
classic.ui.unit-actions.sleep.label = 休眠
classic.ui.unit-actions.sleep.desc = 让该单位保持待命，直到再次需要它。
classic.ui.unit-actions.found-city.label = 建立城市
classic.ui.unit-actions.found-city.desc = 在合适的定居点建立一座新城市。
classic.ui.unit-actions.improve.label = 改良
classic.ui.unit-actions.improve.desc = 用合适的农场、矿山或其他改良设施开发地块。
classic.ui.unit-actions.road.label = 修建道路
classic.ui.unit-actions.road.desc = 修建道路，连接城市并便利通行。
classic.ui.unit-actions.chop.label = 砍伐森林
classic.ui.unit-actions.chop.desc = 清除此处的森林；木材可加快最近城市的生产。
classic.ui.unit-actions.spread.label = 传播宗教
classic.ui.unit-actions.spread.desc = 向此处或该单位相邻的城市传播你的宗教。
classic.ui.unit-actions.remove-heresy.label = 清除异端
classic.ui.unit-actions.remove-heresy.desc = 清除你此处城市中的其他宗教。
classic.ui.unit-actions.holy-site.label = 圣地
classic.ui.unit-actions.holy-site.desc = 在你领土内的此地块上建造圣地；先知将被消耗。
classic.ui.unit-actions.great-work.label = 艺术巨作
classic.ui.unit-actions.great-work.desc = 在最近的同类空闲槽位中创作一件巨作。
classic.ui.unit-actions.treatise.label = 政治论文
classic.ui.unit-actions.treatise.desc = 撰写论文：将最近数回合的文化量存入你的文化池。
classic.ui.unit-actions.concert.label = 巡回演出
classic.ui.unit-actions.concert.desc = 在该国领土上演出：提升对其及其邻国的影响力。
classic.ui.unit-actions.excavate.label = 发掘
classic.ui.unit-actions.excavate.desc = 发掘此处的古迹遗址；完成后由你选择带走什么。
classic.ui.unit-actions.great-improvement.label = 建造改良设施
classic.ui.unit-actions.great-improvement.desc = 消耗该伟人，在此地块上建造其专属改良设施。
classic.ui.unit-actions.discover.label = 发现科技
classic.ui.unit-actions.discover.desc = 消耗该大科学家，换取最近数回合的科研量。
classic.ui.unit-actions.hurry-wonder.label = 加速生产
classic.ui.unit-actions.hurry-wonder.desc = 消耗该大工程师，加速本城的生产。
classic.ui.unit-actions.golden-age.label = 开启黄金时代
classic.ui.unit-actions.golden-age.desc = 消耗该伟人，开启一个黄金时代。
classic.ui.unit-actions.trade-mission.label = 贸易使命
classic.ui.unit-actions.trade-mission.desc = 消耗该大商人，在城邦换取金币。
classic.ui.unit-actions.promote.label = 晋升
classic.ui.unit-actions.promote.desc = 选择该单位凭经验赢得的晋升。
classic.ui.unit-actions.upgrade.label = 升级
classic.ui.unit-actions.upgrade.desc = 花费金币，把该单位升级为其现代继任者。
classic.ui.unit-actions.set-up.label = 架设
classic.ui.unit-actions.set-up.desc = 架设攻城武器；之后才能射击。
classic.ui.unit-actions.pillage.label = 掠夺
classic.ui.unit-actions.pillage.desc = 摧毁此处的改良设施或道路；单位恢复生命，你获得金币。
classic.ui.unit-actions.intercept.label = 拦截
classic.ui.unit-actions.intercept.desc = 待命，拦截该单位周围的敌方飞机。
classic.ui.unit-actions.trade-route.label = 贸易路线
classic.ui.unit-actions.trade-route.desc = 选择要通商的城市：该单位可开辟的路线及其收益。
classic.ui.unit-actions.plunder.label = 劫掠路线
classic.ui.unit-actions.plunder.desc = 劫掠商队位于此处的敌方贸易路线：其金币归你所有。
classic.ui.unit-actions.buy-city-state.label = 收购城邦
classic.ui.unit-actions.buy-city-state.desc = 消耗该商人：此处的城邦成为你的傀儡。
classic.ui.unit-actions.sell-goods.label = 出售异域货物
classic.ui.unit-actions.sell-goods.desc = 在外国领土旁出售货物：金币和经验随距离你首都的远近而增加。
classic.ui.unit-actions.sweep.label = 空中扫荡
classic.ui.unit-actions.sweep.desc = 派飞机飞越某个地块，与那里的拦截机交战；本回合行动结束。
classic.ui.unit-actions.target-move = 点击地块以移动
classic.ui.unit-actions.target-attack = 点击地块以攻击
classic.ui.unit-actions.target-sweep = 点击射程内的地块进行扫荡
classic.ui.unit-actions.target-other = 点击地块：{ $action }
classic.ui.unit-actions.preview-short = 预览
classic.ui.unit-actions.preview-action = 预览：{ $action }
classic.ui.unit-actions.preview-only = 仅预览
classic.ui.unit-actions.unit = 单位
classic.ui.unit-actions.choose-promotion = 选择晋升
