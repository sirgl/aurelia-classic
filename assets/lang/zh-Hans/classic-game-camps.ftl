classic.game.income.and = { $a }，{ $b }
classic.game.kill.notice = { $source }：{ $parts }（{ $barbarian ->
    [yes] 击杀蛮族
   *[no] 击杀敌人
}）
classic.game.kill.notice-plain = { $parts }（{ $barbarian ->
    [yes] 击杀蛮族
   *[no] 击杀敌人
}）
classic.game.plunder.improvement = 改良设施被掠夺：+{ NUMBER($gold) }金币
classic.game.plunder.city = 城市被掠夺：+{ NUMBER($gold) }金币
classic.game.plunder.route = 贸易路线被掠夺：+{ NUMBER($gold) }金币

classic.game.wonder.found = 发现自然奇观：{ $name }
classic.game.wonder.found-with = 发现自然奇观：{ $name }：{ $parts }
classic.game.wonder.gold-first = +{ NUMBER($n) }金币（首个发现者）
classic.game.wonder.happiness = +{ NUMBER($n) }幸福
