# Translation of classic-game-camps.ftl into zh-Hans. Keys are in the order of the English file.
# Lines marked TODO still hold the English text: translate them and delete the marker.

classic.game.camp.cleared = 蛮族营地已被清除：+{ NUMBER($gold) }金币
classic.game.camp.cleared-joined = 蛮族营地已被清除：+{ NUMBER($gold) }金币；一名蛮族加入了你（+{ NUMBER($joined) }金币）
classic.game.camp.joined = 营地中的一名蛮族加入了你：+{ NUMBER($gold) }金币

classic.game.income.gold = +{ NUMBER($n) }金币
classic.game.income.culture = +{ NUMBER($n) }文化
classic.game.income.science = +{ NUMBER($n) }科研
classic.game.income.food = +{ NUMBER($n) }食物
classic.game.income.production = +{ NUMBER($n) }产能
