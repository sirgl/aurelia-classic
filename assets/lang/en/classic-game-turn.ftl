# Civ V game layer: the notices at the end of a turn (game/turn.rs).

classic.game.turn.ai-stopped = The other players' turns stopped: { $why }
classic.game.turn.golden-age-begins = A golden age begins ({ $n ->
    [one] { $n } turn
   *[other] { $n } turns
})
classic.game.turn.golden-age-ended = The golden age has ended
classic.game.turn.mood-content = The people are content again
classic.game.turn.mood-unhappy = The empire is unhappy ({ $value }): growth and production suffer
classic.game.turn.mood-very-unhappy = The empire is very unhappy ({ $value }): no new cities
classic.game.turn.dig-finished = A dig is finished: choose what to take on the Culture screen
classic.game.turn.opinion-content = Your people are content with the ideology
classic.game.turn.opinion-murmurs = Murmurs of doubt about your ideology
classic.game.turn.opinion-unrest = Unrest against your ideology
classic.game.turn.opinion-upheaval = Upheaval: the people want another ideology
classic.game.turn.city-lost = { $city } was lost
classic.game.turn.city-captured = { $city } was captured
classic.game.turn.city-grew = { $city } grew to { $n }
classic.game.turn.city-built = { $city } built { $building }
classic.game.turn.city-attacked = { $city } was attacked
classic.game.turn.unit-destroyed = Your { $name } was destroyed
classic.game.turn.unit-attacked = Your { $name } was attacked ({ $hp } HP left)
classic.game.turn.unit-trained = { $name } trained
classic.game.turn.researched = Researched { $tech }
classic.game.turn.new-era = A new era begins: the { $era }
classic.game.turn.won = You won the game
classic.game.turn.lost-to-another = Another nation won the game
classic.game.turn.fell = Your nation fell
classic.game.turn.nuclear-strike = { $nation } used a nuclear weapon. The nations that have met them will remember it.
