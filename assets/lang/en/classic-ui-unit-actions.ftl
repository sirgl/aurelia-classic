# Unit order buttons: caption and explanation of every order.

classic.ui.unit-actions.move.label = Move
classic.ui.unit-actions.move.desc = Choose a destination and inspect a route for this unit.
classic.ui.unit-actions.attack.label = Attack
classic.ui.unit-actions.attack.desc = Inspect a target and compare the expected combat outcome.
classic.ui.unit-actions.fortify.label = Fortify
classic.ui.unit-actions.fortify.desc = Take a defensive position and hold this tile.
classic.ui.unit-actions.skip.label = Skip
classic.ui.unit-actions.skip.desc = Leave this unit in place for the current turn.
classic.ui.unit-actions.heal.label = Heal
classic.ui.unit-actions.heal.desc = Rest in place until the unit has recovered.
classic.ui.unit-actions.sleep.label = Sleep
classic.ui.unit-actions.sleep.desc = Keep this unit waiting until it is needed again.
classic.ui.unit-actions.found-city.label = Found city
classic.ui.unit-actions.found-city.desc = Establish a new city at a suitable settlement site.
classic.ui.unit-actions.improve.label = Improve
classic.ui.unit-actions.improve.desc = Develop a tile with a suitable farm, mine or other improvement.
classic.ui.unit-actions.road.label = Build road
classic.ui.unit-actions.road.desc = Construct a road to connect cities and travel routes.
classic.ui.unit-actions.chop.label = Chop forest
classic.ui.unit-actions.chop.desc = Clear the forest here; the timber speeds up the nearest city.
classic.ui.unit-actions.spread.label = Spread religion
classic.ui.unit-actions.spread.desc = Spread your religion to the city here or next to this unit.
classic.ui.unit-actions.remove-heresy.label = Remove heresy
classic.ui.unit-actions.remove-heresy.desc = Remove other religions from your city here.
classic.ui.unit-actions.holy-site.label = Holy Site
classic.ui.unit-actions.holy-site.desc = Build a Holy Site on this tile of your land; the prophet is spent.
classic.ui.unit-actions.great-work.label = Great work
classic.ui.unit-actions.great-work.desc = Create a great work in the nearest free slot of its kind.
classic.ui.unit-actions.treatise.label = Political treatise
classic.ui.unit-actions.treatise.desc = Write a treatise: the culture of the last turns into your pool.
classic.ui.unit-actions.concert.label = Concert tour
classic.ui.unit-actions.concert.desc = Perform in this nation's land: influence on it and its neighbours.
classic.ui.unit-actions.excavate.label = Excavate
classic.ui.unit-actions.excavate.desc = Dig the antiquity site here; you choose what to take when it is done.
classic.ui.unit-actions.great-improvement.label = Build improvement
classic.ui.unit-actions.great-improvement.desc = Use the great person up to build its improvement on this tile.
classic.ui.unit-actions.discover.label = Discover technology
classic.ui.unit-actions.discover.desc = Use the great scientist up for the science of the last turns.
classic.ui.unit-actions.hurry-wonder.label = Hurry production
classic.ui.unit-actions.hurry-wonder.desc = Use the great engineer up to rush the production of this city.
classic.ui.unit-actions.golden-age.label = Start golden age
classic.ui.unit-actions.golden-age.desc = Use the great person up to start a golden age.
classic.ui.unit-actions.trade-mission.label = Trade mission
classic.ui.unit-actions.trade-mission.desc = Use the great merchant up for gold in a city-state.
classic.ui.unit-actions.promote.label = Promote
classic.ui.unit-actions.promote.desc = Choose a promotion the unit's experience has earned.
classic.ui.unit-actions.upgrade.label = Upgrade
classic.ui.unit-actions.upgrade.desc = Turn the unit into its modern successor for gold.
classic.ui.unit-actions.set-up.label = Set up
classic.ui.unit-actions.set-up.desc = Set up the siege weapon; it can shoot afterwards.
classic.ui.unit-actions.pillage.label = Pillage
classic.ui.unit-actions.pillage.desc = Destroy the improvement or road here; the unit heals and you take gold.
classic.ui.unit-actions.intercept.label = Intercept
classic.ui.unit-actions.intercept.desc = Wait to intercept enemy aircraft around this unit.
classic.ui.unit-actions.trade-route.label = Trade route
classic.ui.unit-actions.trade-route.desc = Choose a city to trade with: the routes this unit may start and what they yield.
classic.ui.unit-actions.plunder.label = Plunder route
classic.ui.unit-actions.plunder.desc = Plunder the enemy trade route whose caravan is here: its gold is yours.
classic.ui.unit-actions.buy-city-state.label = Buy city-state
classic.ui.unit-actions.buy-city-state.desc = Use the merchant up: the city-state here becomes your puppet.
classic.ui.unit-actions.sell-goods.label = Sell exotic goods
classic.ui.unit-actions.sell-goods.desc = Sell the cargo next to a foreign land: gold and experience grow with the distance from your capital.
classic.ui.unit-actions.sweep.label = Air sweep
classic.ui.unit-actions.sweep.desc = Send the aircraft over a tile to fight the interceptors there; it spends the turn.

classic.ui.unit-actions.target-move = Click a tile to move
classic.ui.unit-actions.target-attack = Click a tile to attack
classic.ui.unit-actions.target-sweep = Click a tile in range to sweep it
classic.ui.unit-actions.target-other = Click a tile to { $action }
classic.ui.unit-actions.preview-short = Preview
classic.ui.unit-actions.preview-action = Preview: { $action }
classic.ui.unit-actions.preview-only = Preview only
classic.ui.unit-actions.unit = Unit
classic.ui.unit-actions.choose-promotion = CHOOSE A PROMOTION
classic.ui.unit-actions.label-key = { $label } ({ $key })
classic.ui.unit-actions.hint-blocked =
    { $label }
    { $what }
    Unavailable: { $reason }
