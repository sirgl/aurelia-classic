## the sample technologies and policies
classic.ui.screen-progress.tech.agriculture.name = Agriculture
classic.ui.screen-progress.tech.agriculture.desc = Cultivate the land and turn seasonal harvests into a settled way of life.
classic.ui.screen-progress.tech.agriculture.unlocks =
    Farms
    A foundation for city growth
classic.ui.screen-progress.tech.pottery.name = Pottery
classic.ui.screen-progress.tech.pottery.desc = Preserve food and knowledge in vessels shaped by skilled hands.
classic.ui.screen-progress.tech.pottery.unlocks =
    Granary
    The path to Writing and Calendar
classic.ui.screen-progress.tech.mining.name = Mining
classic.ui.screen-progress.tech.mining.desc = Bring the wealth beneath the hills into the light. Tools and stone build lasting cities.
classic.ui.screen-progress.tech.mining.unlocks =
    Mines
    Chop forests
    The path to Masonry and Bronze Working
classic.ui.screen-progress.tech.animal-husbandry.name = Animal Husbandry
classic.ui.screen-progress.tech.animal-husbandry.desc = Form a partnership with the animals of the plains, at home and on the road.
classic.ui.screen-progress.tech.animal-husbandry.unlocks =
    Pastures
    Reveal horses
classic.ui.screen-progress.tech.writing.name = Writing
classic.ui.screen-progress.tech.writing.desc = Let discoveries outlive their discoverers. Writing transforms memory into shared knowledge.
classic.ui.screen-progress.tech.writing.unlocks =
    Library
    Embassies
    The path to Philosophy
classic.ui.screen-progress.tech.masonry.name = Masonry
classic.ui.screen-progress.tech.masonry.desc = Shape stone into walls, monuments and buildings that endure.
classic.ui.screen-progress.tech.masonry.unlocks =
    Quarry
    Walls
classic.ui.screen-progress.tech.calendar.name = Calendar
classic.ui.screen-progress.tech.calendar.desc = Read the rhythm of the heavens and organize the work of the seasons.
classic.ui.screen-progress.tech.calendar.unlocks =
    Plantations
    A measured agricultural year
classic.ui.screen-progress.tech.bronze-working.name = Bronze Working
classic.ui.screen-progress.tech.bronze-working.desc = Combine metals into a stronger alloy and equip a new generation of warriors.
classic.ui.screen-progress.tech.bronze-working.unlocks =
    Spearman
    Reveal iron
classic.ui.screen-progress.tech.philosophy.name = Philosophy
classic.ui.screen-progress.tech.philosophy.desc = Ask what makes a city just, a belief sound and a nation worth building.
classic.ui.screen-progress.tech.philosophy.unlocks =
    Temple
    National College
classic.ui.screen-progress.policy.tradition.name = Tradition
classic.ui.screen-progress.policy.tradition.desc = Build a lasting capital. Tradition rewards a compact nation with deep roots.
classic.ui.screen-progress.policy.tradition.effect =
    More culture in the capital
    Faster border expansion
classic.ui.screen-progress.policy.aristocracy.name = Aristocracy
classic.ui.screen-progress.policy.aristocracy.desc = Great patrons support the ambitious works that define an age.
classic.ui.screen-progress.policy.aristocracy.effect = Faster construction of wonders
classic.ui.screen-progress.policy.legalism.name = Legalism
classic.ui.screen-progress.policy.legalism.desc = A common body of law gives city life a stable foundation.
classic.ui.screen-progress.policy.legalism.effect = Culture buildings in your first cities
classic.ui.screen-progress.policy.liberty.name = Liberty
classic.ui.screen-progress.policy.liberty.desc = Give new communities room to flourish. Liberty favours expansion and shared opportunity.
classic.ui.screen-progress.policy.liberty.effect =
    Culture in every city
    Open the path to new settlements
classic.ui.screen-progress.policy.republic.name = Republic
classic.ui.screen-progress.policy.republic.desc = Citizens join their work toward the prosperity of the whole.
classic.ui.screen-progress.policy.republic.effect = More production in every city
classic.ui.screen-progress.policy.collective-rule.name = Collective Rule
classic.ui.screen-progress.policy.collective-rule.desc = New settlements become a common endeavour, supported by the capital.
classic.ui.screen-progress.policy.collective-rule.effect = Faster settlers in the capital
classic.ui.screen-progress.policy.honour.name = Honour
classic.ui.screen-progress.policy.honour.desc = A shared martial tradition turns individual courage into a disciplined army.
classic.ui.screen-progress.policy.honour.effect =
    Stronger defence against barbarians
    Culture from early victories
classic.ui.screen-progress.policy.warrior-code.name = Warrior Code
classic.ui.screen-progress.policy.warrior-code.desc = A warrior's duty gives courage a purpose and an army its leaders.
classic.ui.screen-progress.policy.warrior-code.effect = Faster training of melee units
classic.ui.screen-progress.policy.discipline.name = Discipline
classic.ui.screen-progress.policy.discipline.desc = Soldiers learn to trust the strength of the companion beside them.
classic.ui.screen-progress.policy.discipline.effect = Combat strength beside friendly units
