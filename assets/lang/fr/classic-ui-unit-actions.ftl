# Translation of classic-ui-unit-actions.ftl into fr. Keys are in the order of the English file.
# Lines marked TODO still hold the English text: translate them and delete the marker.

classic.ui.unit-actions.move.label = Se déplacer
classic.ui.unit-actions.move.desc = Choisissez une destination et examinez l'itinéraire de cette unité.
classic.ui.unit-actions.attack.label = Attaquer
classic.ui.unit-actions.attack.desc = Examinez une cible et comparez l'issue probable du combat.
classic.ui.unit-actions.fortify.label = Se fortifier
classic.ui.unit-actions.fortify.desc = Adoptez une position défensive et tenez cette case.
classic.ui.unit-actions.skip.label = Passer
classic.ui.unit-actions.skip.desc = Laisse cette unité en place pour le tour en cours.
classic.ui.unit-actions.heal.label = Se soigner
classic.ui.unit-actions.heal.desc = Repose l'unité sur place jusqu'à sa guérison.
classic.ui.unit-actions.sleep.label = Dormir
classic.ui.unit-actions.sleep.desc = Garde cette unité en attente jusqu'à ce qu'on en ait de nouveau besoin.
classic.ui.unit-actions.found-city.label = Fonder une ville
classic.ui.unit-actions.found-city.desc = Établit une nouvelle ville sur un site propice.
classic.ui.unit-actions.improve.label = Aménager
classic.ui.unit-actions.improve.desc = Développe une case avec une ferme, une mine ou un autre aménagement adapté.
classic.ui.unit-actions.road.label = Construire une route
classic.ui.unit-actions.road.desc = Construit une route pour relier les villes et les itinéraires de voyage.
classic.ui.unit-actions.chop.label = Abattre la forêt
classic.ui.unit-actions.chop.desc = Défriche la forêt ici ; le bois accélère la production de la ville la plus proche.
classic.ui.unit-actions.spread.label = Propager la religion
classic.ui.unit-actions.spread.desc = Propage votre religion dans la ville située ici ou à côté de cette unité.
classic.ui.unit-actions.remove-heresy.label = Éliminer l'hérésie
classic.ui.unit-actions.remove-heresy.desc = Élimine les autres religions de votre ville située ici.
classic.ui.unit-actions.holy-site.label = Lieu saint
classic.ui.unit-actions.holy-site.desc = Construit un lieu saint sur cette case de votre territoire ; le prophète est consommé.
classic.ui.unit-actions.great-work.label = Grande œuvre
classic.ui.unit-actions.great-work.desc = Crée une grande œuvre dans l'emplacement libre le plus proche de son type.
classic.ui.unit-actions.treatise.label = Traité politique
classic.ui.unit-actions.treatise.desc = Rédige un traité : la culture des derniers tours rejoint votre réserve.
classic.ui.unit-actions.concert.label = Tournée de concerts
classic.ui.unit-actions.concert.desc = Se produit sur le territoire de cette nation : influence sur elle et ses voisines.
classic.ui.unit-actions.excavate.label = Fouiller
classic.ui.unit-actions.excavate.desc = Fouille le site antique ici ; vous choisissez ce que vous prenez une fois terminé.
classic.ui.unit-actions.great-improvement.label = Construire l'aménagement
classic.ui.unit-actions.great-improvement.desc = Sacrifie le grand personnage pour construire son aménagement sur cette case.
classic.ui.unit-actions.discover.label = Découvrir une technologie
classic.ui.unit-actions.discover.desc = Sacrifie le grand scientifique pour la science des derniers tours.
classic.ui.unit-actions.hurry-wonder.label = Accélérer la production
classic.ui.unit-actions.hurry-wonder.desc = Sacrifie le grand ingénieur pour hâter la production de cette ville.
classic.ui.unit-actions.golden-age.label = Lancer un âge d'or
classic.ui.unit-actions.golden-age.desc = Sacrifie le grand personnage pour lancer un âge d'or.
classic.ui.unit-actions.trade-mission.label = Mission commerciale
classic.ui.unit-actions.trade-mission.desc = Sacrifie le grand marchand pour obtenir de l'or dans une cité-État.
classic.ui.unit-actions.promote.label = Promouvoir
classic.ui.unit-actions.promote.desc = Choisissez une promotion méritée par l'expérience de l'unité.
classic.ui.unit-actions.upgrade.label = Moderniser
classic.ui.unit-actions.upgrade.desc = Transforme l'unité en son successeur moderne contre de l'or.
classic.ui.unit-actions.set-up.label = Installer
classic.ui.unit-actions.set-up.desc = Installe l'arme de siège ; elle pourra ensuite tirer.
classic.ui.unit-actions.pillage.label = Piller
classic.ui.unit-actions.pillage.desc = Détruit l'aménagement ou la route ici ; l'unité se soigne et vous gagnez de l'or.
classic.ui.unit-actions.intercept.label = Intercepter
classic.ui.unit-actions.intercept.desc = Attend pour intercepter les avions ennemis autour de cette unité.
classic.ui.unit-actions.trade-route.label = Route commerciale
classic.ui.unit-actions.trade-route.desc = Choisissez une ville avec qui commercer : les routes que cette unité peut ouvrir et leur rendement.
classic.ui.unit-actions.plunder.label = Piller la route
classic.ui.unit-actions.plunder.desc = Pille la route commerciale ennemie dont la caravane est ici : son or est à vous.
classic.ui.unit-actions.buy-city-state.label = Acheter la cité-État
classic.ui.unit-actions.buy-city-state.desc = Sacrifie le marchand : la cité-État ici devient votre marionnette.
classic.ui.unit-actions.sell-goods.label = Vendre des biens exotiques
classic.ui.unit-actions.sell-goods.desc = Vend la cargaison près d'une terre étrangère : l'or et l'expérience croissent avec la distance à votre capitale.
classic.ui.unit-actions.sweep.label = Balayage aérien
classic.ui.unit-actions.sweep.desc = Envoie l'appareil au-dessus d'une case pour combattre les intercepteurs qui s'y trouvent ; il dépense son tour.
classic.ui.unit-actions.target-move = Cliquez sur une case pour vous y déplacer
classic.ui.unit-actions.target-attack = Cliquez sur une case pour attaquer
classic.ui.unit-actions.target-sweep = Cliquez sur une case à portée pour la balayer
classic.ui.unit-actions.target-other = Cliquez sur une case pour : { $action }
classic.ui.unit-actions.preview-short = Aperçu
classic.ui.unit-actions.preview-action = Aperçu : { $action }
classic.ui.unit-actions.preview-only = Aperçu uniquement
classic.ui.unit-actions.unit = Unité
classic.ui.unit-actions.choose-promotion = CHOISISSEZ UNE PROMOTION
