# Translation of classic-game-turn.ftl into es. Keys are in the order of the English file.
# Lines marked TODO still hold the English text: translate them and delete the marker.

classic.game.turn.ai-stopped = Los turnos de los demás jugadores se detuvieron: { $why }
classic.game.turn.golden-age-begins = Comienza una edad de oro ({ $n ->
    [one] { $n } turno
   *[other] { $n } turnos
})
classic.game.turn.golden-age-ended = La edad de oro ha terminado
classic.game.turn.mood-content = El pueblo vuelve a estar contento
classic.game.turn.mood-unhappy = El imperio está descontento ({ $value }): el crecimiento y la producción se resienten
classic.game.turn.mood-very-unhappy = El imperio está muy descontento ({ $value }): no se pueden fundar ciudades
classic.game.turn.dig-finished = Termina una excavación: elija qué llevarse en la pantalla de Cultura
classic.game.turn.opinion-content = Su pueblo está conforme con la ideología
classic.game.turn.opinion-murmurs = Murmullos de duda sobre su ideología
classic.game.turn.opinion-unrest = Agitación contra su ideología
classic.game.turn.opinion-upheaval = Sublevación: el pueblo quiere otra ideología
classic.game.turn.city-lost = Se perdió { $city }
classic.game.turn.city-captured = { $city } fue capturada
classic.game.turn.city-grew = { $city } creció a { $n }
classic.game.turn.city-built = { $city } construyó { $building }
classic.game.turn.city-attacked = { $city } fue atacada
classic.game.turn.unit-destroyed = Se destruyó su { $name }
classic.game.turn.unit-attacked = Su { $name } sufrió un ataque (quedan { $hp } PV)
classic.game.turn.unit-trained = Entrenado: { $name }
classic.game.turn.researched = Investigado: { $tech }
classic.game.turn.new-era = Comienza una nueva era: { $era }
classic.game.turn.won = Ha ganado la partida
classic.game.turn.lost-to-another = Otra nación ganó la partida
classic.game.turn.fell = Su nación ha caído
classic.game.turn.nuclear-strike = { $nation } ha usado un arma nuclear. Las civilizaciones que la conocen no lo olvidarán.
