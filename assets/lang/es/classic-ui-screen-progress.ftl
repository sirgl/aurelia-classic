classic.ui.screen-progress.tech.agriculture.name = Agricultura
classic.ui.screen-progress.tech.agriculture.desc = Cultive la tierra y convierta las cosechas de temporada en una forma de vida asentada.
classic.ui.screen-progress.tech.agriculture.unlocks = 
    Granjas
    Una base para el crecimiento de las ciudades
classic.ui.screen-progress.tech.pottery.name = Alfarería
classic.ui.screen-progress.tech.pottery.desc = Conserve alimentos y saberes en vasijas moldeadas por manos expertas.
classic.ui.screen-progress.tech.pottery.unlocks = 
    Granero
    El camino hacia Escritura y Calendario
classic.ui.screen-progress.tech.mining.name = Minería
classic.ui.screen-progress.tech.mining.desc = Saque a la luz la riqueza bajo las colinas. Herramientas y piedra levantan ciudades duraderas.
classic.ui.screen-progress.tech.mining.unlocks = 
    Minas
    Talar bosques
    El camino hacia Albañilería y Trabajo del bronce
classic.ui.screen-progress.tech.animal-husbandry.name = Ganadería
classic.ui.screen-progress.tech.animal-husbandry.desc = Forme una alianza con los animales de las llanuras, en casa y en el camino.
classic.ui.screen-progress.tech.animal-husbandry.unlocks = 
    Pastizales
    Revela los caballos
classic.ui.screen-progress.tech.writing.name = Escritura
classic.ui.screen-progress.tech.writing.desc = Haga que los descubrimientos sobrevivan a sus descubridores. La escritura convierte la memoria en saber compartido.
classic.ui.screen-progress.tech.writing.unlocks = 
    Biblioteca
    Embajadas
    El camino hacia Filosofía
classic.ui.screen-progress.tech.masonry.name = Albañilería
classic.ui.screen-progress.tech.masonry.desc = Dé forma a la piedra en murallas, monumentos y edificios que perduran.
classic.ui.screen-progress.tech.masonry.unlocks = 
    Cantera
    Murallas
classic.ui.screen-progress.tech.calendar.name = Calendario
classic.ui.screen-progress.tech.calendar.desc = Lea el ritmo de los cielos y organice el trabajo de las estaciones.
classic.ui.screen-progress.tech.calendar.unlocks = 
    Plantaciones
    Un año agrícola medido
classic.ui.screen-progress.tech.bronze-working.name = Trabajo del bronce
classic.ui.screen-progress.tech.bronze-working.desc = Combine metales en una aleación más fuerte y equipe a una nueva generación de guerreros.
classic.ui.screen-progress.tech.bronze-working.unlocks = 
    Lancero
    Revela el hierro
classic.ui.screen-progress.tech.philosophy.name = Filosofía
classic.ui.screen-progress.tech.philosophy.desc = Pregunte qué hace justa a una ciudad, sólida a una creencia y digna de construirse a una nación.
classic.ui.screen-progress.tech.philosophy.unlocks = 
    Templo
    Colegio nacional
classic.ui.screen-progress.policy.tradition.name = Tradición
classic.ui.screen-progress.policy.tradition.desc = Construya una capital duradera. La Tradición recompensa a una nación compacta de hondas raíces.
classic.ui.screen-progress.policy.tradition.effect = 
    Más cultura en la capital
    Expansión de fronteras más rápida
classic.ui.screen-progress.policy.aristocracy.name = Aristocracia
classic.ui.screen-progress.policy.aristocracy.desc = Grandes mecenas respaldan las obras ambiciosas que definen una época.
classic.ui.screen-progress.policy.aristocracy.effect = Construcción de maravillas más rápida
classic.ui.screen-progress.policy.legalism.name = Legalismo
classic.ui.screen-progress.policy.legalism.desc = Un cuerpo común de leyes da a la vida urbana una base estable.
classic.ui.screen-progress.policy.legalism.effect = Edificios de cultura en sus primeras ciudades
classic.ui.screen-progress.policy.liberty.name = Libertad
classic.ui.screen-progress.policy.liberty.desc = Dé espacio para florecer a las nuevas comunidades. La Libertad favorece la expansión y la oportunidad compartida.
classic.ui.screen-progress.policy.liberty.effect = 
    Cultura en todas las ciudades
    Abre el camino a nuevos asentamientos
classic.ui.screen-progress.policy.republic.name = República
classic.ui.screen-progress.policy.republic.desc = Los ciudadanos unen su trabajo por la prosperidad del conjunto.
classic.ui.screen-progress.policy.republic.effect = Más producción en todas las ciudades
classic.ui.screen-progress.policy.collective-rule.name = Gobierno colectivo
classic.ui.screen-progress.policy.collective-rule.desc = Los nuevos asentamientos se vuelven una empresa común, respaldada por la capital.
classic.ui.screen-progress.policy.collective-rule.effect = Colonos más rápidos en la capital
classic.ui.screen-progress.policy.honour.name = Honor
classic.ui.screen-progress.policy.honour.desc = Una tradición marcial compartida convierte el valor individual en un ejército disciplinado.
classic.ui.screen-progress.policy.honour.effect = 
    Mayor defensa contra los bárbaros
    Cultura por las primeras victorias
classic.ui.screen-progress.policy.warrior-code.name = Código guerrero
classic.ui.screen-progress.policy.warrior-code.desc = El deber del guerrero da un propósito al valor y jefes al ejército.
classic.ui.screen-progress.policy.warrior-code.effect = Entrenamiento más rápido de unidades cuerpo a cuerpo
classic.ui.screen-progress.policy.discipline.name = Disciplina
classic.ui.screen-progress.policy.discipline.desc = Los soldados aprenden a confiar en la fuerza del compañero que tienen al lado.
classic.ui.screen-progress.policy.discipline.effect = Fuerza de combate junto a unidades aliadas
