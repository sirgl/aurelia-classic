# Translation of classic-ui-unit-actions.ftl into es. Keys are in the order of the English file.
# Lines marked TODO still hold the English text: translate them and delete the marker.

classic.ui.unit-actions.move.label = Mover
classic.ui.unit-actions.move.desc = Elija un destino y revise una ruta para esta unidad.
classic.ui.unit-actions.attack.label = Atacar
classic.ui.unit-actions.attack.desc = Examine un objetivo y compare el resultado previsto del combate.
classic.ui.unit-actions.fortify.label = Fortificar
classic.ui.unit-actions.fortify.desc = Adopte una posición defensiva y mantenga esta casilla.
classic.ui.unit-actions.skip.label = Omitir
classic.ui.unit-actions.skip.desc = Deje esta unidad en su sitio durante el turno actual.
classic.ui.unit-actions.heal.label = Curar
classic.ui.unit-actions.heal.desc = Descanse en el sitio hasta que la unidad se recupere.
classic.ui.unit-actions.sleep.label = Dormir
classic.ui.unit-actions.sleep.desc = Mantenga esta unidad a la espera hasta que vuelva a hacer falta.
classic.ui.unit-actions.found-city.label = Fundar ciudad
classic.ui.unit-actions.found-city.desc = Establezca una ciudad nueva en un lugar adecuado.
classic.ui.unit-actions.improve.label = Mejorar
classic.ui.unit-actions.improve.desc = Desarrolle una casilla con una granja, mina u otra mejora adecuada.
classic.ui.unit-actions.road.label = Construir camino
classic.ui.unit-actions.road.desc = Construya un camino para conectar ciudades y rutas de viaje.
classic.ui.unit-actions.chop.label = Talar bosque
classic.ui.unit-actions.chop.desc = Despeje el bosque de aquí; la madera acelera la ciudad más cercana.
classic.ui.unit-actions.spread.label = Difundir religión
classic.ui.unit-actions.spread.desc = Difunda su religión a la ciudad de aquí o a la contigua a esta unidad.
classic.ui.unit-actions.remove-heresy.label = Eliminar herejía
classic.ui.unit-actions.remove-heresy.desc = Elimine otras religiones de su ciudad de aquí.
classic.ui.unit-actions.holy-site.label = Lugar sagrado
classic.ui.unit-actions.holy-site.desc = Construya un Lugar sagrado en esta casilla de su territorio; el profeta se consume.
classic.ui.unit-actions.great-work.label = Gran obra
classic.ui.unit-actions.great-work.desc = Cree una gran obra en el espacio libre más cercano de su tipo.
classic.ui.unit-actions.treatise.label = Tratado político
classic.ui.unit-actions.treatise.desc = Escriba un tratado: la cultura de los últimos turnos pasa a su reserva.
classic.ui.unit-actions.concert.label = Gira de conciertos
classic.ui.unit-actions.concert.desc = Actúe en el territorio de esta nación: influencia sobre ella y sus vecinas.
classic.ui.unit-actions.excavate.label = Excavar
classic.ui.unit-actions.excavate.desc = Excave el yacimiento de antigüedades de aquí; al terminar elige qué llevarse.
classic.ui.unit-actions.great-improvement.label = Construir mejora
classic.ui.unit-actions.great-improvement.desc = Consuma al gran personaje para construir su mejora en esta casilla.
classic.ui.unit-actions.discover.label = Descubrir tecnología
classic.ui.unit-actions.discover.desc = Consuma al gran científico por la ciencia de los últimos turnos.
classic.ui.unit-actions.hurry-wonder.label = Acelerar producción
classic.ui.unit-actions.hurry-wonder.desc = Consuma al gran ingeniero para acelerar la producción de esta ciudad.
classic.ui.unit-actions.golden-age.label = Iniciar edad de oro
classic.ui.unit-actions.golden-age.desc = Consuma al gran personaje para iniciar una edad de oro.
classic.ui.unit-actions.trade-mission.label = Misión comercial
classic.ui.unit-actions.trade-mission.desc = Consuma al gran mercader por oro en una ciudad-estado.
classic.ui.unit-actions.promote.label = Ascender
classic.ui.unit-actions.promote.desc = Elija un ascenso que la experiencia de la unidad haya merecido.
classic.ui.unit-actions.upgrade.label = Mejorar unidad
classic.ui.unit-actions.upgrade.desc = Convierta la unidad en su sucesora moderna a cambio de oro.
classic.ui.unit-actions.set-up.label = Montar
classic.ui.unit-actions.set-up.desc = Monte el arma de asedio; después podrá disparar.
classic.ui.unit-actions.pillage.label = Saquear
classic.ui.unit-actions.pillage.desc = Destruya la mejora o el camino de aquí; la unidad se cura y usted se lleva oro.
classic.ui.unit-actions.intercept.label = Interceptar
classic.ui.unit-actions.intercept.desc = Espere para interceptar aviones enemigos en torno a esta unidad.
classic.ui.unit-actions.trade-route.label = Ruta comercial
classic.ui.unit-actions.trade-route.desc = Elija una ciudad con la que comerciar: las rutas que esta unidad puede iniciar y lo que rinden.
classic.ui.unit-actions.plunder.label = Saquear ruta
classic.ui.unit-actions.plunder.desc = Saquee la ruta comercial enemiga cuya caravana está aquí: su oro es suyo.
classic.ui.unit-actions.buy-city-state.label = Comprar ciudad-estado
classic.ui.unit-actions.buy-city-state.desc = Consuma al mercader: la ciudad-estado de aquí pasa a ser su títere.
classic.ui.unit-actions.sell-goods.label = Vender bienes exóticos
classic.ui.unit-actions.sell-goods.desc = Venda la carga junto a una tierra extranjera: el oro y la experiencia crecen con la distancia a su capital.
classic.ui.unit-actions.sweep.label = Barrido aéreo
classic.ui.unit-actions.sweep.desc = Envía el avión sobre una casilla para combatir allí a los interceptores; gasta el turno.
classic.ui.unit-actions.target-move = Clic en una casilla para mover
classic.ui.unit-actions.target-attack = Clic en una casilla para atacar
classic.ui.unit-actions.target-sweep = Haga clic en una casilla al alcance para barrerla
classic.ui.unit-actions.target-other = Clic en una casilla para: { $action }
classic.ui.unit-actions.preview-short = Vista previa
classic.ui.unit-actions.preview-action = Vista previa: { $action }
classic.ui.unit-actions.preview-only = Solo vista previa
classic.ui.unit-actions.unit = Unidad
classic.ui.unit-actions.choose-promotion = ELIJA UN ASCENSO
classic.ui.unit-actions.label-key = { $label } ({ $key })
classic.ui.unit-actions.hint-blocked = 
    { $label }
    { $what }
