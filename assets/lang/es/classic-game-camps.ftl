# Translation of classic-game-camps.ftl into es. Keys are in the order of the English file.
# Lines marked TODO still hold the English text: translate them and delete the marker.

classic.game.camp.cleared = Campamento bárbaro eliminado: +{ NUMBER($gold) } de oro
classic.game.camp.cleared-joined = Campamento bárbaro eliminado: +{ NUMBER($gold) } de oro; un bárbaro se ha unido a usted (+{ NUMBER($joined) } de oro)
classic.game.camp.joined = Un bárbaro del campamento se ha unido a usted: +{ NUMBER($gold) } de oro

classic.game.income.gold = +{ NUMBER($n) } de oro
classic.game.income.culture = +{ NUMBER($n) } de cultura
classic.game.income.science = +{ NUMBER($n) } de ciencia
classic.game.income.food = +{ NUMBER($n) } de comida
classic.game.income.production = +{ NUMBER($n) } de producción
classic.game.income.faith = +{ NUMBER($n) } de fe
classic.game.income.and = { $a }, { $b }
classic.game.kill.notice = { $source }: { $parts } { $barbarian ->
    [yes] por un bárbaro abatido
   *[no] por un enemigo abatido
}
classic.game.kill.notice-plain = { $parts } { $barbarian ->
    [yes] por un bárbaro abatido
   *[no] por un enemigo abatido
}
classic.game.plunder.improvement = Mejora saqueada: +{ NUMBER($gold) } de oro
classic.game.plunder.city = Ciudad saqueada: +{ NUMBER($gold) } de oro
classic.game.plunder.route = Ruta comercial saqueada: +{ NUMBER($gold) } de oro

classic.game.wonder.found = Maravilla natural encontrada: { $name }
classic.game.wonder.found-with = Maravilla natural encontrada: { $name }: { $parts }
classic.game.wonder.gold-first = +{ NUMBER($n) } de oro (primera en encontrarla)
classic.game.wonder.happiness = +{ NUMBER($n) } de felicidad
