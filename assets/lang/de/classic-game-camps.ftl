# Translation of classic-game-camps.ftl into de. Keys are in the order of the English file.
# Lines marked TODO still hold the English text: translate them and delete the marker.

classic.game.camp.cleared = Barbarenlager geräumt: +{ NUMBER($gold) } Gold
classic.game.camp.cleared-joined = Barbarenlager geräumt: +{ NUMBER($gold) } Gold; ein Barbar hat sich Ihnen angeschlossen (+{ NUMBER($joined) } Gold)
classic.game.camp.joined = Ein Barbar aus dem Lager hat sich Ihnen angeschlossen: +{ NUMBER($gold) } Gold

classic.game.income.gold = +{ NUMBER($n) } Gold
classic.game.income.culture = +{ NUMBER($n) } Kultur
classic.game.income.science = +{ NUMBER($n) } Wissenschaft
classic.game.income.food = +{ NUMBER($n) } Nahrung
classic.game.income.production = +{ NUMBER($n) } Produktion
classic.game.income.faith = +{ NUMBER($n) } Glaube
classic.game.income.and = { $a }, { $b }
classic.game.kill.notice = { $source }: { $parts } { $barbarian ->
    [yes] für einen besiegten Barbaren
   *[no] für einen besiegten Gegner
}
classic.game.kill.notice-plain = { $parts } { $barbarian ->
    [yes] für einen besiegten Barbaren
   *[no] für einen besiegten Gegner
}
classic.game.plunder.improvement = Verbesserung geplündert: +{ NUMBER($gold) } Gold
classic.game.plunder.city = Stadt geplündert: +{ NUMBER($gold) } Gold
classic.game.plunder.route = Handelsroute geplündert: +{ NUMBER($gold) } Gold

classic.game.wonder.found = Naturwunder entdeckt: { $name }
classic.game.wonder.found-with = Naturwunder entdeckt: { $name }: { $parts }
classic.game.wonder.gold-first = +{ NUMBER($n) } Gold (als Erster entdeckt)
classic.game.wonder.happiness = +{ NUMBER($n) } Zufriedenheit
