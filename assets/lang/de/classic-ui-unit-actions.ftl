classic.ui.unit-actions.preview-short = Vorschau
classic.ui.unit-actions.preview-action = Vorschau: { $action }
classic.ui.unit-actions.preview-only = Nur Vorschau
classic.ui.unit-actions.unit = Einheit
classic.ui.unit-actions.choose-promotion = BEFÖRDERUNG WÄHLEN
