# Translation of classic-game-turn.ftl into de. Keys are in the order of the English file.
# Lines marked TODO still hold the English text: translate them and delete the marker.

classic.game.turn.ai-stopped = Die Züge der anderen Spieler wurden gestoppt: { $why }
classic.game.turn.golden-age-begins = Ein Goldenes Zeitalter beginnt ({ $n ->
    [one] { $n } Zug
   *[other] { $n } Züge
})
classic.game.turn.golden-age-ended = Das Goldene Zeitalter ist zu Ende
classic.game.turn.mood-content = Das Volk ist wieder zufrieden
classic.game.turn.mood-unhappy = Das Reich ist unzufrieden ({ $value }): Wachstum und Produktion leiden
classic.game.turn.mood-very-unhappy = Das Reich ist sehr unzufrieden ({ $value }): keine neuen Städte
classic.game.turn.dig-finished = Eine Ausgrabung ist abgeschlossen: Wählen Sie im Kulturbildschirm, was Sie mitnehmen
classic.game.turn.opinion-content = Ihr Volk ist mit der Ideologie zufrieden
classic.game.turn.opinion-murmurs = Unmut regt sich gegen Ihre Ideologie
classic.game.turn.opinion-unrest = Unruhen gegen Ihre Ideologie
classic.game.turn.opinion-upheaval = Aufruhr: Das Volk will eine andere Ideologie
classic.game.turn.city-lost = { $city } ging verloren
classic.game.turn.city-captured = { $city } wurde erobert
classic.game.turn.city-grew = { $city } ist auf { $n } gewachsen
classic.game.turn.city-built = { $city } hat { $building } gebaut
classic.game.turn.city-attacked = { $city } wurde angegriffen
classic.game.turn.unit-destroyed = Ihre Einheit { $name } wurde zerstört
classic.game.turn.unit-attacked = Ihre Einheit { $name } wurde angegriffen ({ $hp } TP übrig)
classic.game.turn.unit-trained = { $name } ausgebildet
classic.game.turn.researched = { $tech } erforscht
classic.game.turn.new-era = Ein neues Zeitalter beginnt: { $era }
classic.game.turn.won = Sie haben das Spiel gewonnen
classic.game.turn.lost-to-another = Eine andere Nation hat das Spiel gewonnen
classic.game.turn.fell = Ihre Nation ist gefallen
classic.game.turn.nuclear-strike = { $nation } hat eine Atomwaffe eingesetzt. Die Zivilisationen, die sie kennen, werden es nicht vergessen.
