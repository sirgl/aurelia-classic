classic.ui.screen-progress.tech.bronze-working.name = 青銅器
classic.ui.screen-progress.tech.bronze-working.desc = 金属を合わせてより強い合金を作り、新世代の戦士を武装させます。
classic.ui.screen-progress.tech.bronze-working.unlocks = 
    槍兵
