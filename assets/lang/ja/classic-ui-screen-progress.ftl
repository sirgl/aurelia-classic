    馬が見えるようになる
classic.ui.screen-progress.tech.writing.name = 筆記
classic.ui.screen-progress.tech.writing.desc = 発見を発見者より長く生き延びさせます。筆記は記憶を共有の知識へと変えます。
classic.ui.screen-progress.tech.writing.unlocks = 
