classic.ui.screen-progress.tech.animal-husbandry.name = 牧畜
classic.ui.screen-progress.tech.animal-husbandry.desc = 平原の動物たちと手を結び、暮らしにも旅にも役立てます。
classic.ui.screen-progress.tech.animal-husbandry.unlocks = 
